{
  "name": "MovieApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "=================================================================ANDROID============================================================================": "ANDROID",
    "=================================================================ANDROID=============================================================================": "ANDROID",
    "=================================================================ANDROID==============================================================================": "ANDROID",
    "=====NOTE4====================================================================": "NOTE 4 (note4) - DEVICE",
    "list-androids": "adb devices",
    "note4": "react-native run-android  --device R3CMC035PHN",
    "=====GALAXYS22================================================================": "GALAXY S22 (galaxys22) - THIS WILL RUN 2 COMMANDS TO LOAD AVD & RUN APP",
    "list-avds": "emulator -list-avds",
    "galaxys22": "zsh scripts/run-galaxy-s22.sh",
    "loadgalaxys22": "emulator -avd Galaxy_S22_API_34 -port 5554 -no-snapshot-load &",
    "appgalaxys22": "adb -s emulator-5554 wait-for-device && npx react-native run-android --device emulator-5554",
    "======ANY=======================================================================": "PIXEL 8 AVD (android) - PICKS 1ST AVAILABLE",
    "android": "react-native run-android",
    "======DEBUGGING=================================================================": "RELOADING AND BUILDING ONLY",
    "reload-emulator-5554": "adb -s emulator-5554 shell input keyevent 82",
    "reload-device-note4": "adb -s R3CMC035PHN shell input keyevent 82",
    "buildandroid": "cd android && ./gradlew assembleDebug",
    "===================================================================iOS============================================================================================": "iOS",
    "===================================================================iOS=============================================================================================": "iOS",
    "===================================================================iOS==============================================================================================": "iOS",
    "=======IPHONE16=================================================================": "iPHONE 16 PRO MAX (iphone16promax) - DEVICE",
    "list-iphones": "xcrun xctrace list devices",
    "iphone16promaxb:kup": "react-native run-ios --device 'Carlo’s iPhone'",
    "iphone16promax": "react-native run-ios --udid 00008140-000524CA1A88801C --extra-params \"-allowProvisioningUpdates -allowProvisioningDeviceRegistration\"",
    "=======IPHHONE17================================================================": "iPHONE 17 PRO MAX (iphone17promax) SIMULATOR ",
    "iphone17promax": "react-native run-ios --simulator 'iPhone 17 Pro Max'",
    "=======IPADPRO13================================================================": "iPAD PRO 13-INCH (ipadpro13) SIMULATOR",
    "ipadpro13": "react-native run-ios --simulator 'iPad Pro 13-inch (M5)'",
    "=======IPHONE14PLUS==============================================================": "iPHONE 14 PLUS (iphone14plus) SIMULATOR",
    "iphone14plus": "react-native run-ios --simulator 'iPhone 14 Plus'",
    "=======IPHONE8PLUS===============================================================": "iPHONE 8 PLUS (iphone8plus) SIMULATOR",
    "iphone8plus": "react-native run-ios --simulator 'iPhone 8 Plus'",
    "=======ANY======================================================================": "iPHONE 15 (ios) - PICKS 1ST AVAILABLE",
    "ios": "react-native run-ios",
    "pods": "bundle exec pod install --project-directory=ios",
    "===================================================================METRO=============================================================================================": "METRO",
    "start": "react-native start",
    "start-reset": "react-native start --reset-cache",
    "postinstall": "patch-package",
    "buildios": "cd ios && xcodebuild -workspace MovieApp.xcworkspace -scheme MovieApp -configuration Debug -sdk iphonesimulator build",
    "=================================================================PACKAGE============================================================================": "PACKAGE",
    "version-movieapp": "zsh scripts/version-movieapp.sh",
    "iosarchive": "zsh scripts/iosarchive.sh",
    "iosarchive-validation": "zsh scripts/ios-archive-validation.sh",
    "androidbundle": "zsh scripts/androidbundle.sh",
    "androidbundle-validation": "zsh scripts/android-bundle-validation.sh",
    "==================================================================TESTS==============================================================================================": "TESTS",
    "=======ESLINT===============================================================================================": "ESLINT (lint) - TEST SYNTAX  - Statically analyze code, catch ",
    "========ESLINT==============================================================================================": "     syntax issues, enforce coding standards, prevent ",
    "=========ESLINT=============================================================================================": "     common bugs before runtime.",
    "lint": "eslint .",
    "========ESLINT-EASIER-TO-UNDERSTAND==========================================================================": "ESLINT (lintc) - TEST SYNTAX - EASY READ",
    "lintc": "eslint . --format compact",
    "======= =ESLINT-QUIET========================================================================================": "ESLINT (lintq) - TEST SYNTAX ERRORS ONLY - (no warnings)",
    "lintq": "eslint . --quiet",
    "========JEST================================================================================================": "JEST (jest) - UNIT AND INTEGRATION TESTS executes your unit and integration tests",
    "=========JEST===============================================================================================": "     in a controlled environment ... ",
    "==========JEST==============================================================================================": "     Eg. npx jest src/components/MyComponent.test.tsx",
    "test": "jest",
    "========TYPESCRIPT==========================================================================================": "TYPESCRIPT TEST - TypeScript performs static type checking to ensure code adheres",
    "=========TYPESCRIPT=========================================================================================": "     to defined types, preventing type-related runtime errors and improving",
    "==========TYPESCRIPT========================================================================================": "     maintainability and tooling support.",
    "===========TYPESCRIPT=======================================================================================": "  TSC --noEmit → does not generate JS",
    "tsne": "tsc --noEmit"
  },
  "appDependencyComments": {
    "=====================================section-1": "Default Dependencies",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "@react-native/new-app-screen": "0.84.1",
    "react-native-safe-area-context": "^5.5.2",
    "=====================================section-2": "Data Retrieval Dependencies",
    "axios": "^1.13.6",
    "@tanstack/react-query": "^5.95.2",
    "=====================================section-3": "Date Picker Dependencies",
    "react-native-date-picker": "5.0.13",
    "=====================================section-4": "Back Caret",
    "@react-native-vector-icons/ionicons": "^13.1.0",
    "=====================================section-5": "Navigation Dependencies",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/drawer": "^7.10.2",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-reanimated": "^4.3.1",
    "react-native-screens": "^4.25.1",
    "react-native-worklets": "^0.8.3",
    "=====================================section-6": "Patch Management",
    "patch-package": "^8.0.1"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.0",
    "@react-native-vector-icons/ionicons": "^13.1.0",
    "@react-native/new-app-screen": "0.84.1",
    "@react-navigation/drawer": "^7.10.2",
    "@react-navigation/native": "^7.2.4",
    "@tanstack/react-query": "^5.95.2",
    "axios": "^1.13.6",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-date-picker": "5.0.13",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-onesignal": "^5.4.7",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.25.1",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "^0.8.3",
    "react-native-youtube-iframe": "^2.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
